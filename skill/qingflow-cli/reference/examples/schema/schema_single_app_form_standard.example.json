[
  {
    "section": "基础信息",
    "rows": [
      [
        {
          "name": "工单编号",
          "type": "text",
          "data_title": true,
          "required": true,
          "description": "唯一业务编号"
        },
        {
          "name": "工单名称",
          "type": "text",
          "required": true
        },
        {
          "name": "工单状态",
          "type": "select",
