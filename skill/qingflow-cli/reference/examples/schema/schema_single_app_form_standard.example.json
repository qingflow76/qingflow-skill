        {
          "name": "附件资料",
          "type": "attachment",
          "data_cover": true
        }
      ],
      [
        {
          "name": "处理说明",
          "type": "multiline"
        }
      ]
    ]
  },
  {
    "section": "明细信息",
    "rows": [
      [
        {
          "name": "处理明细",
