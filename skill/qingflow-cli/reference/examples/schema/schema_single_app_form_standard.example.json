          "options": ["待处理", "处理中", "已完成", "已关闭"]
        }
      ],
      [
        {
          "name": "负责人",
          "type": "member"
        },
        {
          "name": "负责部门",
          "type": "department",
          "department_scope": {"mode": "all"}
        },
        {
          "name": "计划完成日期",
          "type": "date"
        }
      ]
    ]
  },
  {
    "section": "业务信息",
    "rows": [
      [
        {
          "name": "计划数量",
          "type": "number"
        },
        {
          "name": "预算金额",
          "type": "amount"
        },
        {
          "name": "是否加急",
          "type": "boolean"
        }
      ],
      [
        {
          "name": "业务标签",
          "type": "multi_select",
          "options": ["重点", "风险", "跨部门", "需复核"]
